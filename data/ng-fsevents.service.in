# SPDX-License-Identifier: CC0-1.0
[Unit]
Description=NG file change journal (when things last changed in each folder of the users' homes)
Documentation=https://github.com/Morzilla/ng-fsevents

[Service]
Type=dbus
BusName=org.ng.FsEvents1
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/ng-fseventsd
StateDirectory=ng-fsevents
StateDirectoryMode=0700
# (where the top of a btrfs filesystem is mounted, read-only, for this service alone: see the README)
RuntimeDirectory=ng-fsevents
RuntimeDirectoryMode=0700

# runs as root, but with only what fanotify needs: filesystem marks and turning file handles into paths
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
